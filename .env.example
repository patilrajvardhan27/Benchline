# Copy to .env for local development. Never commit the real file.

# --- PostgreSQL -------------------------------------------------
POSTGRES_DB=benchline
POSTGRES_USER=benchline
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432

# --- Kafka ------------------------------------------------------
KAFKA_BOOTSTRAP=localhost:9092

# --- Auth -------------------------------------------------------
# Local profile validates HS256 tokens signed with this secret (32+ chars).
# Production uses OIDC_ISSUER_URI instead and ignores the secret.
DEV_JWT_SECRET=local-only-secret-at-least-32-characters-long
OIDC_ISSUER_URI=

# --- Feature flags (flagd) --------------------------------------
FLAGD_HOST=localhost
FLAGD_PORT=8013

# --- Observability ----------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=benchline

# --- Web (build time, public values only) -----------------------
# Vite reads these from web/.env.local, not from this file. Copy the VITE_ lines there.
VITE_API_BASE_URL=http://localhost:8080
VITE_DEMO_MODE=false
VITE_CONTACT_EMAIL=contact@example.com
VITE_OPERATOR_NAME=Benchline maintainer
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=benchline-web
# Local dev server only (never in a production build): a token from scripts/dev_token.py
VITE_DEV_TOKEN=

# --- Item normalizer and LiteLLM (optional) -----------------------
# Direct mode: the pipeline calls the provider itself through the LiteLLM library.
# BENCHLINE_LLM_MODEL=openai/gpt-4o-mini
# BENCHLINE_LLM_FALLBACK_MODEL=anthropic/claude-haiku-5-5
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# BENCHLINE_LLM_MAX_USD=2.00
# BENCHLINE_LLM_MAX_FAILURES=5      # stop asking the model after this many failures in a row
#
# Gateway mode: the pipeline calls the LiteLLM gateway with a budget-capped virtual key.
# BENCHLINE_LLM_MODEL=openai/benchline-normalizer
# BENCHLINE_LLM_API_BASE=http://localhost:4000
# BENCHLINE_LLM_API_KEY=            # a virtual key created through the gateway, see docs
LITELLM_MASTER_KEY=               # starts with sk-; admin key for the gateway
NORMALIZER_API_KEY=               # provider key the gateway uses for the primary model
NORMALIZER_FALLBACK_API_KEY=      # provider key for the fallback model
